# Exemplo de formato. Nenhuma credencial real deve ser versionada.
# Estas variáveis precisam ser exportadas; não há carregamento automático de .env.
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Preencha com o identificador de um modelo textual habilitado na Groq.
LLM_MODEL=
AGENT_ID=default
AGENT_INSTRUCTIONS="Responda de forma clara e objetiva."
PORT=3000
LLM_TIMEOUT_MS=30000
